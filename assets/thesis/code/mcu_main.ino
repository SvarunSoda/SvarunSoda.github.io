// wrapper function for TDV subtraction 
// performs the operation for a specified number of iterations
// returns the number of iterations the TDV operation was executed for
inline uint32_t TDVsSubtract(const uint8_t shiftingTdvIdx, const uint8_t stationaryTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_TDVsSubtract_Start}@
{
  uint32_t runs;
  float result;

  // setting the expected TDV values...
  TDVTargetValues[resultTdvIdx] = TDVTargetValues[stationaryTdvIdx] - TDVTargetValues[shiftingTdvIdx];
  
  runs = 0;
  do
  {
    if (runs >= 1000000)
      break;
    runs++;
    // execute one TDV operation iteration...
    TDVsSubtractCycles(shiftingTdvIdx, stationaryTdvIdx, resultTdvIdx, operatingCycles, duration);
    result = TDVGet(resultTdvIdx, operatingCycles, rollingAverage);
  } while ((result < tolerance) || (result > (1.0 - tolerance)));

  return runs;
} //@\label{line:operationMcu_TDVsSubtract_End}@

// function that performs the TDV subtraction operation for a single iteration
FASTRUN __attribute__((noinline)) void TDVsSubtractCycles(const uint8_t shiftingTdvIdx, const uint8_t stationaryTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration) //@\label{line:operationMcu_TDVsSubtractCycles_Start}@
{
  TDVUnpause(shiftingTdvIdx);
  TDVUnpause(stationaryTdvIdx);
  TDVUnpause(resultTdvIdx);

  const uint32_t startTime = micros();
  while ((micros() - startTime) <= duration)
  {
    // alignment operation step...
    {
      // pausing the shifting TDV
      // if the XOR between the shifting & stationary TDVs' reference clocks is TRUE...
      LogicGateXOR(TDVGetRef(shiftingTdvIdx, false), TDVGetRef(stationaryTdvIdx, false)) 
      ? TDVPause(shiftingTdvIdx) : TDVUnpause(shiftingTdvIdx);
    }

    // construction operation step...
    {
      // pausing the result TDV's value clock 
      // if the XOR between the stationary & result TDVs' value clocks is TRUE...
      LogicGateXOR(TDVGetVal(stationaryTdvIdx, false), TDVGetVal(resultTdvIdx, false)) 
      ? TDVPauseVal(resultTdvIdx) : TDVUnpauseVal(resultTdvIdx);

      // pausing the result TDV's reference clock 
      // if the XOR between the shifting TDV's value clock & the result TDV's reference clock is TRUE...
      LogicGateXOR(TDVGetVal(shiftingTdvIdx, false), TDVGetRef(resultTdvIdx, false)) 
      ? TDVPauseRef(resultTdvIdx) : TDVUnpauseRef(resultTdvIdx);
    }
  }

  TDVUnpause(shiftingTdvIdx);
  TDVUnpause(stationaryTdvIdx);
  TDVUnpause(resultTdvIdx);
} //@\label{line:operationMcu_TDVsSubtractCycles_End}@

// wrapper function for TDV addition 
// performs the operation for a specified number of iterations
// returns the number of iterations the TDV operation was executed for
inline uint32_t TDVsAdd(const uint8_t shiftingTdvIdx, const uint8_t stationaryTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_TDVsAdd_Start}@
{
  uint32_t runs;
  float result;

  // setting the expected TDV values...
  TDVTargetValues[resultTdvIdx] = TDVTargetValues[shiftingTdvIdx] + TDVTargetValues[stationaryTdvIdx];
  
  runs = 0;
  do
  {
    if (runs >= 1000000)
      break;
    runs++;
    // execute one TDV operation iteration...
    TDVsAddCycles(shiftingTdvIdx, stationaryTdvIdx, resultTdvIdx, operatingCycles, duration);
    result = TDVGet(resultTdvIdx, operatingCycles, rollingAverage);
  } while ((result < tolerance) || (result > (1.0 - tolerance)));

  return runs;
} //@\label{line:operationMcu_TDVsAdd_End}@

// function that performs the TDV addition operation for a single iteration
FASTRUN __attribute__((noinline)) void TDVsAddCycles(const uint8_t shiftingTdvIdx, const uint8_t stationaryTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration) //@\label{line:operationMcu_TDVsAddCycles_Start}@
{
