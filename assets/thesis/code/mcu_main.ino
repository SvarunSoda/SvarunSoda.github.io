//// OSCILLATOR FUNCTIONS ////

// function that measures a single duty cycle duration for a given oscillator
FASTRUN __attribute__((noinline)) uint32_t OscillatorGetCycles(const uint8_t oscillatorIdx, const bool invert, const uint32_t rollingAverage) //@\label{line:operationMcu_OscillatorGetCycles_Start}@
{
  uint32_t startCycles, elapsedCycles, measuredCycles;
  volatile bool checkState, prevCheckState;

  measuredCycles = 0;

  // measuring the duty cycle for number of rolling averages...
  for (uint32_t i = 0; i < rollingAverage; i++)
  {
    // waiting for rising edge...
    checkState = OscillatorGetState(oscillatorIdx, invert);
    do
    {
      prevCheckState = checkState;
      checkState = OscillatorGetState(oscillatorIdx, invert);
    } while (!(checkState && (prevCheckState != checkState)));

    // waiting for falling edge, while measuring cycles...
    startCycles = CPUCyclesGet();
    checkState = OscillatorGetState(oscillatorIdx, invert);
    do
    {
      prevCheckState = checkState;
      checkState = OscillatorGetState(oscillatorIdx, invert);
    } while (!(!checkState && (prevCheckState != checkState)));

    // saving the measured cycles...
    elapsedCycles = CPUCyclesGet() - startCycles;
    if (i == 0)
      measuredCycles = elapsedCycles;
    else
      measuredCycles = (measuredCycles + elapsedCycles) / 2;
  }

  return measuredCycles;
} //@\label{line:operationMcu_OscillatorGetCycles_End}@

// function that reads the instantaneous state of a given oscillator
FASTRUN __attribute__((noinline)) volatile bool OscillatorGetState(const uint8_t oscillatorIdx, const bool invert) //@\label{line:operationMcu_OscillatorGetState_Start}@
{
  return invert ? !DigitalPinGet(PINS_SIGNAL[oscillatorIdx]) : DigitalPinGet(PINS_SIGNAL[oscillatorIdx]);
} //@\label{line:operationMcu_OscillatorGetState_End}@

// function that pauses a given oscillator
FASTRUN __attribute__((noinline)) void OscillatorPause(const uint8_t oscillatorIdx) //@\label{line:operationMcu_OscillatorPause_Start}@
{
  DigitalPinSet(PINS_PAUSE[oscillatorIdx], LOW);
} //@\label{line:operationMcu_OscillatorPause_End}@

// function that unpauses a given oscillator
FASTRUN __attribute__((noinline)) void OscillatorUnpause(const uint8_t oscillatorIdx) //@\label{line:operationMcu_OscillatorUnpause_Start}@
