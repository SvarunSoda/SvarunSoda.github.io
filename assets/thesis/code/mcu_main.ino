// function that simulates a digital exclusive-OR (XOR) logic gate
inline bool LogicGateXOR(const bool inputA, const bool inputB) //@\label{line:operationMcu_LogicGateXOR_Start}@
{
  return (inputA != inputB);
} //@\label{line:operationMcu_LogicGateXOR_End}@

