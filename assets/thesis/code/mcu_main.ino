// returns the number of iterations the TDV was reset for
inline uint32_t TDVReset(const uint8_t tdvIdx, const uint32_t operatingCycles, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_TDVReset_Start}@
