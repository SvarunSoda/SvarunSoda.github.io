} //@\label{line:operationMcu_DigitalPinInit_End}@

// function that gets the absolute difference between two 32-bit unsigned integer numbers
inline uint32_t UnsignedGetDifference(const uint32_t valueA, const uint32_t valueB) //@\label{line:operationMcu_UnsignedGetDifference_Start}@
{
  return (valueB > valueA) ? (valueB - valueA) : (valueA - valueB);
} //@\label{line:operationMcu_UnsignedGetDifference_End}@

// function that subtracts two 32-bit unsigned integer numbers
// truncates result to 0 if an overflow is detected
inline uint32_t SubtractUnsigned(const uint32_t numA, const uint32_t numB) //@\label{line:operationMcu_SubtractUnsigned_Start}@
{
  return (numB > numA) ? 0 : (numA - numB);
} //@\label{line:operationMcu_SubtractUnsigned_End}@