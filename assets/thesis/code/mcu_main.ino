      // if the XOR between the shifting TDV's value clock & the stationary TDV's reference clock is TRUE...
      LogicGateXOR(TDVGetVal(shiftingTdvIdx, false), TDVGetRef(stationaryTdvIdx, false)) 
      ? TDVPause(shiftingTdvIdx) : TDVUnpause(shiftingTdvIdx);
    }

    // construction operation step...
    {
      // pausing the result TDV's value clock 
      // if the XOR between the stationary & result TDVs' value clocks is TRUE...
      LogicGateXOR(TDVGetVal(stationaryTdvIdx, false), TDVGetVal(resultTdvIdx, false)) 
      ? TDVPauseVal(resultTdvIdx) : TDVUnpauseVal(resultTdvIdx);

      // pausing the result TDV's reference clock 
      // if the XOR between the shifting & result TDVs' reference clocks is TRUE...
      LogicGateXOR(TDVGetRef(shiftingTdvIdx, false), TDVGetRef(resultTdvIdx, false)) 
      ? TDVPauseRef(resultTdvIdx) : TDVUnpauseRef(resultTdvIdx);
    }
  }

  TDVUnpause(shiftingTdvIdx);
  TDVUnpause(stationaryTdvIdx);
  TDVUnpause(resultTdvIdx);
} //@\label{line:operationMcu_TDVsAddCycles_End}@

// wrapper function for TDV inversion 
// performs the operation for a specified number of iterations
// returns the number of iterations the TDV operation was executed for
inline uint32_t TDVInvert(const uint8_t operandTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_TDVInvert_Start}@
{
  uint32_t runs;
  float result;

  // setting the expected TDV values...
  TDVTargetValues[resultTdvIdx] = abs(1.0 - TDVTargetValues[operandTdvIdx]);
  
  runs = 0;
  do
  {
    if (runs >= 1000000)
      break;
    runs++;
    // execute one TDV operation iteration...
    TDVInvertCycles(operandTdvIdx, resultTdvIdx, operatingCycles, duration);
    result = TDVGet(resultTdvIdx, operatingCycles, rollingAverage);
  } while ((result < tolerance) || (result > (1.0 - tolerance)));

  return runs;
} //@\label{line:operationMcu_TDVInvert_End}@

// function that performs the TDV inversion operation for a single iteration
FASTRUN __attribute__((noinline)) void TDVInvertCycles(const uint8_t operandTdvIdx, const uint8_t resultTdvIdx, const uint32_t operatingCycles, const uint32_t duration) //@\label{line:operationMcu_TDVInvertCycles_Start}@
{
  TDVUnpause(operandTdvIdx);
  TDVUnpause(resultTdvIdx);

  const uint32_t startTime = micros();
  while ((micros() - startTime) <= duration)
  {
    // operation step...
    {
      // pausing the result TDV's value clock 
      // if the XOR between the operand TDV's inverted reference clock & the result TDV's value clock is TRUE...
      LogicGateXOR(TDVGetRef(operandTdvIdx, true), TDVGetVal(resultTdvIdx, false)) 
      ? TDVPauseVal(resultTdvIdx) : TDVUnpauseVal(resultTdvIdx);

      // pausing the result TDV's reference clock 
      // if the XOR between the operand TDV's value clock & the result TDV's reference clock is TRUE...
      LogicGateXOR(TDVGetVal(operandTdvIdx, false), TDVGetRef(resultTdvIdx, false)) 
      ? TDVPauseRef(resultTdvIdx) : TDVUnpauseRef(resultTdvIdx);
    }
  }

  TDVUnpause(operandTdvIdx);
  TDVUnpause(resultTdvIdx);
} //@\label{line:operationMcu_TDVInvertCycles_End}@

