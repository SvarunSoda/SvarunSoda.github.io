} //@\label{line:operationMcu_DigitalPinGet_End}@

// function that initializes a single digital IO pin
inline void DigitalPinInit(const uint8_t pin, const uint8_t mode) //@\label{line:operationMcu_DigitalPinInit_Start}@
{
