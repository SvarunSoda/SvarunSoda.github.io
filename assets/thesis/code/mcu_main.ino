#include <SD.h>

//// GLOBAL VARIALBES ////

const uint8_t OscillatorNum = 6;                                      // number of used oscillator modules in the system
const uint8_t TDVNum = OscillatorNum / 2;                            // number of TDVs used in the system (corresponds to half the number of used oscillators)
const uint8_t TDVOperationNum = 5;

const uint8_t PINS_ENABLE[OscillatorNum] = {23, 20, 17, 0, 3, 5};     // pins for enabling the oscillator modules (digital outputs from MCU)
const uint8_t PINS_PAUSE[OscillatorNum] = {22, 19, 16, 1, 4, 6};      // pins for pausing the oscillator modules' oscillations (digital outputs from MCU)
const uint8_t PINS_SIGNAL[OscillatorNum] = {21, 18, 14, 41, 40, 39};  // pins for reading the clock signals generated by the oscillator modules (digital inputs to MCU)
const uint8_t PINS_UNUSED[2] = {7, 8};
const uint8_t PIN_RNG = 15;

const uint8_t TDVOscillators[TDVNum][2] = {{0, 1}, {2, 3}, {4, 5}}; // oscillator assignments for each TDV used in the system
const float Tolerance = 0.1;                                          // precision of overall system
const uint32_t OscillatorOperatingCycles = 1200000;
const uint32_t OperationTestStarts[TDVOperationNum] = {0, 5999, 3999, 9909, 8049};
const uint32_t OperationTestBatchEnds[TDVOperationNum] = {0, 6000, 4000, 9910, 8050};
const uint32_t OperationTestSteps[TDVOperationNum] = {0, 1, 1, 1, 1};
const uint32_t OperationRunsPerTest = 5;
const uint32_t EvaluationRollingAverage = 1;
const uint32_t FrequencyLogIters = 2000;
const uint32_t OperationEvaluationPhaseLogIters = 3000;

// DO NOT EDIT

float TDVTargetValues[TDVNum];
bool TDVTrackingMask[TDVNum];
uint8_t TDVResultStatus[TDVNum];

#define SDCardConfig SdioConfig(FIFO_SDIO)
FsFile LogFile;

//// MAIN FUNCIONS ////

// function called upon MCU startup
// initializes digital pins, serial lines, initializes TDV conditions & the clock cycle counter register
FLASHMEM void setup() 
{
  // initializing serial lines to computer...
  Serial.begin(9600);

  // initializing all digital pins...
  for (uint8_t i = 0; i < OscillatorNum; i++)
  {
    DigitalPinInit(PINS_ENABLE[i], OUTPUT);
    DigitalPinInit(PINS_PAUSE[i], OUTPUT);
    DigitalPinInit(PINS_SIGNAL[i], INPUT);
  }
  for (uint8_t i = 0; i < 2; i++)
  {
    DigitalPinInit(PINS_UNUSED[i], INPUT);
  }
  DigitalPinInit(PIN_RNG, INPUT);

  // initializing TDV conditions...
  for (uint8_t i = 0; i < TDVNum; i++)
  {
    TDVDisable(i);
    TDVUnpause(i);
    TDVTargetValues[i] = -1.0;
    TDVTrackingMask[i] = true;
    TDVResultStatus[i] = 0;
  }

  // initializing CPU cycle counter register...
  Serial.println("initializing CPU cycle counter register...");
  CPUCyclesInit();
  delay(1000);

  // initializing random number geneator...
  Serial.println("initializing random number generator...");
  RNGInit();
  delay(1000);

  // waiting with initial TDV conditions...
  Serial.println("waiting with initial TDV conditions...");
  delay(10000);
}

// function called repeatedly during MCU operation
// contains topmost-level operation & evaluation logic
FLASHMEM void loop() 
{
  Serial.println("\n---- PROGRAM STARTED ----\n");

  // unpausing & enabling all TDVs...
  for (uint8_t i = 0; i < TDVNum; i++)
  {
    TDVUnpause(i);
    TDVEnable(i);
  }

  delay(120000);

  ProgramRun(OscillatorOperatingCycles, FrequencyLogIters, OperationEvaluationPhaseLogIters, OperationRunsPerTest, EvaluationRollingAverage, Tolerance);

  // when the testing session is concluded, all TDVs are disabled...
  for (uint8_t i = 0; i < TDVNum; i++)
  {
    TDVDisable(i);
  }
  Serial.println("\n---- PROGRAM FINISHED ----");
  while (true) {delay(1000);}
}

//// PROGRAM FUNCTIONS ////

inline void ProgramRun(const uint32_t operatingCycles, const uint32_t frequencyLogIters, const uint32_t phaseLogIters, const uint32_t runsPerOperationTest, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_ProgramRun_Start}@
{
  Serial.println("running program:\n" + ProgramToString(operatingCycles, frequencyLogIters, phaseLogIters, runsPerOperationTest, rollingAverage, tolerance));

  // testing TDV frequencies...
  EvaluateOscillatorFrequencies(frequencyLogIters, operatingCycles, rollingAverage);
  
  // testing TDV setting & resetting (1)...
  EvaluateTDVSet(phaseLogIters, operatingCycles, rollingAverage, tolerance);

  // testing TDV copy (2)...
  EvaluateTDVCopy(phaseLogIters, operatingCycles, runsPerOperationTest, rollingAverage, tolerance);

  // testing TDV invert (3)...
  EvaluateTDVInversion(phaseLogIters, operatingCycles, runsPerOperationTest, rollingAverage, tolerance);

  // testing TDV addition (4)...
  EvaluateTDVAddition(phaseLogIters, operatingCycles, runsPerOperationTest, rollingAverage, tolerance);

  // testing TDV subtraction (5)...
  EvaluateTDVSubtraction(phaseLogIters, operatingCycles, runsPerOperationTest, rollingAverage, tolerance);
} //@\label{line:operationMcu_ProgramRun_End}@

// function that converts a set of evaluation program parameters to a printable string
inline String ProgramToString(const uint32_t operatingCycles, const uint32_t frequencyLogIters, const uint32_t phaseLogIters, const uint32_t runsPerOperationTest, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_ProgramToString_Start}@
{
  String str = "";

  str += "\toscillators: " + String(OscillatorNum);
  str += "\n\tTDVs: {";
  for (uint8_t i = 0; i < TDVNum; i++)
  {
    str += "{" + String(TDVOscillators[i][0]) + ", " + String(TDVOscillators[i][1]) + "}";
    if (i < (TDVNum - 1))
      str += ", ";
  }
  str += "}\n\toperating cycles: " + String(operatingCycles);
  str += "\n\tfrequency evaluation iterations: " + String(frequencyLogIters);
  str += "\n\tphase evaluation iterations: " + String(phaseLogIters);
  str += "\n\toperation test starts: {";
  for (uint8_t i = 0; i < TDVOperationNum; i++)
  {
    str += String(OperationTestStarts[i]);
    if (i < (TDVOperationNum - 1))
      str += ", ";
  }
  str += "}\n\toperation test batch ends: {";
  for (uint8_t i = 0; i < TDVOperationNum; i++)
  {
    str += String(OperationTestBatchEnds[i]);
    if (i < (TDVOperationNum - 1))
      str += ", ";
  }
  str += "}\n\toperation test steps: {";
  for (uint8_t i = 0; i < TDVOperationNum; i++)
  {
    str += String(OperationTestSteps[i]);
    if (i < (TDVOperationNum - 1))
      str += ", ";
  }
  str += "}\n\toperation test runs: " + String(runsPerOperationTest);
  str += "\n\trolling average: " + String(rollingAverage);
  str += "\n\ttolerance: " + String(tolerance);

  return str;
} //@\label{line:operationMcu_ProgramToString_End}@

