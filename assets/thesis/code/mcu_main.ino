// wrapper function for setting of a single TDV 
// sets TDV to the provided value for a specified number of iterations
// returns the number of iterations the TDV was set for
inline uint32_t TDVSet(const uint8_t tdvIdx, float value, const uint32_t operatingCycles, const uint32_t rollingAverage, const float tolerance) //@\label{line:operationMcu_TDVSet_Start}@
{
  uint32_t runs;

  // setting the expected TDV value...
  if (value > 1.0)
    value = 1.0;
  else if (value < 0.0)
    value = 0.0;
  TDVTargetValues[tdvIdx] = value;

  runs = 0;
  do
  {
    if (runs >= 1000000)
      break;
    runs++;
    // execute one TDV setting iteration...
    TDVSetCycles(tdvIdx, (uint32_t)round(value * operatingCycles), operatingCycles);
  } while (!PhaseValuesCheckTolerance(TDVGet(tdvIdx, operatingCycles, rollingAverage), value, tolerance));

  return runs;
} //@\label{line:operationMcu_TDVSet_End}@

// function that sets an TDV to the provided value for a single iteration
// accepts the set value as number of CPU cycles
FASTRUN __attribute__((noinline)) void TDVSetCycles(const uint8_t tdvIdx, const uint32_t setCycles, const uint32_t operatingCycles) //@\label{line:operationMcu_TDVSetCycles_Start}@
{
  volatile bool checkState, prevCheckState;
  bool firstIterGuard;
  uint32_t startCycles, elapsedCycles;

  TDVUnpause(tdvIdx);

  // running the setting for a number of iterations...
  {
    // waiting for rising edge of reference clock
    // while pausing the value clock if it's currently active...
    firstIterGuard = false;
    checkState = TDVGetRef(tdvIdx, false);
    do
    {
      if (firstIterGuard)
      {
        TDVGetVal(tdvIdx, false) ? 
        TDVPauseVal(tdvIdx) : TDVUnpauseVal(tdvIdx);
      }
      firstIterGuard = true;

      prevCheckState = checkState;
      checkState = TDVGetRef(tdvIdx, false);
    } while (!(checkState && (prevCheckState != checkState)));

    // waiting for iters of the set value in CPU cycles
    // while pausing the value clock if it's currently active...
    firstIterGuard = false;
    startCycles = CPUCyclesGet();
    do
    {
      if (firstIterGuard)
      {
        TDVGetVal(tdvIdx, false) ? 
        TDVPauseVal(tdvIdx) : TDVUnpauseVal(tdvIdx);
      }
      firstIterGuard = true;

      elapsedCycles = CPUCyclesGet() - startCycles;
    } while (elapsedCycles <= setCycles);

    // waiting for duration of high duty cycle operation duration
    // while pausing the value clock if it's not currently active...
    firstIterGuard = false;
    startCycles = CPUCyclesGet();
    do
    {
      if (firstIterGuard)
      {
        TDVGetVal(tdvIdx, false) ? 
        TDVUnpauseVal(tdvIdx) : TDVPauseVal(tdvIdx);
      }
      firstIterGuard = true;

      elapsedCycles = CPUCyclesGet() - startCycles;
    } while (elapsedCycles <= operatingCycles);
  }

  TDVUnpause(tdvIdx);
} //@\label{line:operationMcu_TDVSetCycles_End}@

// wrapper function for reading of a single TDV value 
// returns the read value as a range between 0.0 & 2.0
// 0.0 represents 0°, 1.0 represents 180°, 2.0 represents 360°
inline float TDVGet(const uint8_t tdvIdx, const uint32_t operatingCycles, const uint32_t rollingAverage) //@\label{line:operationMcu_TDVGet_Start}@
{
  float value;

  // measuring TDV phase difference in CPU cycles, and converting it to a range between 0.0 & 2.0...
  float avg = 0.0;
  
  for (uint32_t i = 0; i < rollingAverage; i++)
  {
    value = static_cast<float>(TDVGetCycles(tdvIdx, operatingCycles, rollingAverage)) / static_cast<float>(operatingCycles);
    avg += value;
  }
  
  return (avg / rollingAverage);
} //@\label{line:operationMcu_TDVGet_End}@

// function that reads the value of an TDV for a single iteration
// returns the read value as the number of CPU cycles
FASTRUN __attribute__((noinline)) uint32_t TDVGetCycles(const uint8_t tdvIdx, const uint32_t operatingCycles, const uint32_t rollingAverage) //@\label{line:operationMcu_TDVGetCycles_Start}@
{
  volatile bool checkState, prevCheckState;
  uint32_t startCycles, elapsedCycles;

  TDVUnpause(tdvIdx);

  // waiting for rising edge of reference clock...
  checkState = TDVGetRef(tdvIdx, false);
  do
  {
    prevCheckState = checkState;
    checkState = TDVGetRef(tdvIdx, false);
  } while (!(checkState && (prevCheckState != checkState)));

  // waiting for rising edge of value clock, or the maximum (360°)...
  startCycles = CPUCyclesGet();
  checkState = TDVGetVal(tdvIdx, false);
  do
  {
    elapsedCycles = CPUCyclesGet() - startCycles;
    prevCheckState = checkState;
    checkState = TDVGetVal(tdvIdx, false);
  } while (!(checkState && (prevCheckState != checkState)) && (elapsedCycles <= (operatingCycles * 2)));

  // saving the measured value...
  elapsedCycles = CPUCyclesGet() - startCycles;

  TDVUnpause(tdvIdx);

  return elapsedCycles;
} //@\label{line:operationMcu_TDVGetCycles_End}@

