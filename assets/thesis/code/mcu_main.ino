// function that tracks the high & low duty cycle durations of all oscillators in the system over a given duration of time
// saves data to a specified file on an SD card
inline void OscillatorTrackFrequenciesAll(const uint32_t operatingCycles, const uint32_t iters, const uint32_t startTimeMicros, const uint32_t rollingAverage, const String logFilePath) //@\label{line:operationMcu_OscillatorTrackFrequenciesAll_Start}@
{
  String data;

  // declaring buffers for saving all measured data...
  uint32_t timestampsBuff[iters];
  uint32_t cyclesHighBuff[iters][OscillatorNum];
  uint32_t cyclesLowBuff[iters][OscillatorNum];

  // tracking all oscillator operating duty cycle durations over a number of iterations...
  for (uint32_t i = 0; i < iters; i++)
  {
    timestampsBuff[i] = micros() - startTimeMicros;

    for (uint8_t j = 0; j < OscillatorNum; j++)
    {
      cyclesHighBuff[i][j] = OscillatorGetCycles(j, false, rollingAverage);
      cyclesLowBuff[i][j] = OscillatorGetCycles(j, true, rollingAverage);
    }
  }

  // saving measured duty cycle data...
  {
    SDCardInit();
    SDLogFileNew(logFilePath);
    for (uint32_t i = 0; i < iters; i++)
    {
      for (uint8_t j = 0; j < OscillatorNum; j++)
      {
        data = String(operatingCycles) + "|" + 
                      String(j) + "|0|0|" + 
                      String(i) + "|" + 
                      String(timestampsBuff[i]) + "|" + 
                      String(cyclesHighBuff[i][j]);
        SDLogFileWriteLn(data);

        data = String(operatingCycles) + "|" + 
                      String(j) + "|1|0|" + 
                      String(i) + "|" + 
                      String(timestampsBuff[i]) + "|" + 
                      String(cyclesLowBuff[i][j]);
        SDLogFileWriteLn(data);
      }
    }
    SDLogFileClose();
    SDCardClose();
  }
} //@\label{line:operationMcu_OscillatorTrackFrequenciesAll_End}@

