// function that retrieves a single decimal number from the psuedo-random number generator
inline float RNGGet(const float min, const float max, const uint32_t factor) //@\label{line:operationMcu_RNGGet_Start}@
{
  return (RNGGet(min * static_cast<float>(factor), max * static_cast<float>(factor)) / static_cast<float>(factor));
}

// function that retrieves a single unsigned 32-bit integer number from the psuedo-random number generator
inline uint32_t RNGGet(const uint32_t min, const uint32_t max)
{
  return random(min, max);
} //@\label{line:operationMcu_RNGGet_End}@

// function that initializes the psuedo-random number generator
inline void RNGInit() //@\label{line:operationMcu_RNGInit_Start}@
{
  randomSeed(analogRead(PIN_RNG));
} //@\label{line:operationMcu_RNGInit_End}@

//// SUPPORT FUNCTIONS ////

// function that checks whether the two provided phase decimal values are within the provided tolerance of each other
inline bool PhaseValuesCheckTolerance(float valueA, float valueB, const float tolerance) //@\label{line:operationMcu_PhaseValuesCheckTolerance_Start}@
{
  if ((valueA <= 2.0) && (valueA > (2.0 - tolerance)))
    valueA -= 2.0;
  if ((valueB <= 2.0) && (valueB > (2.0 - tolerance)))
    valueB -= 2.0;
  return (abs(valueA - valueB) < tolerance);
} //@\label{line:operationMcu_PhaseValuesCheckTolerance_End}@

// function that converts an TDV phase difference value from the decimal representation (0.0 - 2.0) to the degree representation (0° - 360°)
inline float PhaseValueDecimalToDegrees(const float decimal) //@\label{line:operationMcu_PhaseValueDecimalToDegrees_Start}@
{
  return (decimal / 1.0) * 180;
} //@\label{line:operationMcu_PhaseValueDecimalToDegrees_End}@

// function that sets a single digital IO pin to the provided digital value
inline void DigitalPinSet(const uint8_t pin, const bool value) //@\label{line:operationMcu_DigitalPinSet_Start}@
{
